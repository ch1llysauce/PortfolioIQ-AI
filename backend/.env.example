# ========================================================
# PortfolioIQ AI - Backend Environment Configuration
# ========================================================

# Groq Cloud API Key for Llama-3 AI Career Coach
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Frontend URL for CORS (set to your Vercel deployment URL in production)
# Example: https://your-app.vercel.app
FRONTEND_URL=http://localhost:4200

# GitHub Personal Access Token (optional but recommended)
# Without it: 60 GitHub API requests/hour (unauthenticated)
# With it: 5,000 requests/hour
# Create token at: https://github.com/settings/tokens (only needs 'public_repo' scope)
GITHUB_TOKEN=ghp_your_github_token_here
